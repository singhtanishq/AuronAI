# Auron AI backend configuration
# Copy to backend/.env — all values are optional and safe local defaults apply.

# Server
PORT=3001
NODE_ENV=development

# CORS origin for the frontend dev server (production, same-origin serving
# needs no value unless the frontend is hosted elsewhere)
FRONTEND_URL=http://localhost:5173

# SQLite database file (created and migrated automatically on startup)
DATABASE_PATH=./data/auron.db

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b
# Hard cap for a single generation, including connection time (ms)
OLLAMA_TIMEOUT=300000
# Max time between stream chunks before giving up (ms)
OLLAMA_IDLE_TIMEOUT=60000

# Chat limits
# Character budget of prior history sent to the model
CHAT_MAX_CONTEXT_CHARS=24000
# Max size of a single history message before its head is trimmed
CHAT_MAX_MESSAGE_CHARS=8000
# Concurrent generations allowed per user
CHAT_MAX_CONCURRENT=2

# Rate limits
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Session cookie name (no session secret is needed: sessions are opaque,
# random tokens validated against hashed rows in the database)
SESSION_COOKIE_NAME=auron_session

# Production static serving
# Directory containing the built frontend (default: ../frontend/dist).
# Set only when the frontend is built somewhere else. In production
# (NODE_ENV=production) the backend serves this directory automatically.
# STATIC_ROOT=/absolute/path/to/frontend/dist
